{
  "entities": {
    "Wallet": {
      "title": "Wallet",
      "description": "A user-owned financial wallet or account (Cash, Bank, or E-Wallet).",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name of the wallet (1-40 chars)."
        },
        "type": {
          "type": "string",
          "enum": ["CASH", "BANK", "EWALLET"],
          "description": "Wallet category type."
        },
        "balance": {
          "type": "integer",
          "description": "Current balance in Rupiah (Long)."
        },
        "colorHex": {
          "type": "string",
          "description": "Accent hex color string (#RRGGBB)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": ["name", "type", "balance", "colorHex", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A detailed daily income or expense transaction linked to a wallet.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["INCOME", "EXPENSE"],
          "description": "Transaction direction."
        },
        "amount": {
          "type": "integer",
          "description": "Positive amount in Rupiah (Long > 0)."
        },
        "category": {
          "type": "string",
          "description": "Category label (1-40 chars)."
        },
        "walletId": {
          "type": "string",
          "description": "ID of the wallet document under /users/{userId}/wallets."
        },
        "walletName": {
          "type": "string",
          "description": "Denormalized wallet display name (1-40 chars)."
        },
        "note": {
          "type": "string",
          "description": "Optional detailed note (0-200 chars)."
        },
        "dateKey": {
          "type": "string",
          "description": "Local date string YYYY-MM-DD."
        },
        "monthKey": {
          "type": "string",
          "description": "Local month string YYYY-MM."
        },
        "timeLabel": {
          "type": "string",
          "description": "Local time string HH:mm."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "type",
        "amount",
        "category",
        "walletId",
        "walletName",
        "note",
        "dateKey",
        "monthKey",
        "timeLabel",
        "createdAt",
        "updatedAt"
      ]
    },
    "MonthlyBudget": {
      "title": "MonthlyBudget",
      "description": "Monthly spending limit for a specific expense category.",
      "type": "object",
      "properties": {
        "monthKey": {
          "type": "string",
          "description": "Target month YYYY-MM."
        },
        "category": {
          "type": "string",
          "description": "Expense category name (1-40 chars)."
        },
        "limitAmount": {
          "type": "integer",
          "description": "Monthly spending cap in Rupiah (Long > 0)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": ["monthKey", "category", "limitAmount", "createdAt", "updatedAt"]
    },
    "AgendaItem": {
      "title": "AgendaItem",
      "description": "A daily task or timed schedule entry.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Task or schedule title (1-120 chars)."
        },
        "notes": {
          "type": "string",
          "description": "Optional notes or details (0-400 chars)."
        },
        "dateKey": {
          "type": "string",
          "description": "Scheduled date YYYY-MM-DD."
        },
        "startTime": {
          "type": "string",
          "description": "Optional schedule start time HH:mm."
        },
        "endTime": {
          "type": "string",
          "description": "Optional schedule end time HH:mm."
        },
        "priority": {
          "type": "string",
          "enum": ["HIGH", "MEDIUM", "LOW"],
          "description": "Task priority level."
        },
        "category": {
          "type": "string",
          "description": "Task category label (1-30 chars)."
        },
        "completed": {
          "type": "boolean",
          "description": "Whether the task or schedule item is completed."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "title",
        "notes",
        "dateKey",
        "priority",
        "category",
        "completed",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/wallets/{walletId}": {
      "schema": { "$ref": "#/entities/Wallet" },
      "description": "User's personal wallets (Cash, Bank, E-Wallet)."
    },
    "/users/{userId}/transactions/{txId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "User's detailed daily income and expense transactions."
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": { "$ref": "#/entities/MonthlyBudget" },
      "description": "User's monthly category budgets."
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/AgendaItem" },
      "description": "User's daily tasks and timed schedule entries."
    }
  }
}
